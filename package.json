{
  "name": "knowless",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"bun run server/relay.ts\"",
    "dev:frontend": "vite",
    "dev:relay": "bun run server/relay.ts",
    "build": "vite build",
    "start": "bun run server/relay.ts",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src server --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "test:relay": "bun test server/test/relay-idempotency.test.ts --timeout 30000",
    "smoke:worker": "bunx wrangler deploy --dry-run --config wrangler.toml --env='' --outdir /tmp/knowless-bundle && cp /tmp/knowless-bundle/relay-worker.js ./_smoke-bundle.js && node --experimental-vm-modules worker/test/health-smoke.mjs; CODE=$?; rm -f ./_smoke-bundle.js; exit $CODE",
    "smoke:cctp": "bunx wrangler deploy --dry-run --config wrangler.toml --env='' --outdir /tmp/knowless-bundle && cp /tmp/knowless-bundle/relay-worker.js ./_smoke-bundle.js && node --experimental-vm-modules worker/test/cctp-smoke.mjs; CODE=$?; rm -f ./_smoke-bundle.js; exit $CODE"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.2",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@circle-fin/user-controlled-wallets": "^10.8.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@noble/hashes": "^2.4.0",
    "@openzeppelin/contracts": "5.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@types/qrcode": "^1.5.6",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "happy-dom": "^21.0.3",
    "miniflare": "^4.20260730.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
